# Database Configuration (Required for Validation Engine)
# Use a test/development PostgreSQL database URL
# Format: postgresql://user:password@host:port/database
# or: postgres://user:password@host:port/database

# Primary database URL (used by validation engine)
DATABASE_URL=postgresql://user:password@localhost:5432/test_db

# Alternative Netlify/Heroku environment variable
# POSTGRES_URL=postgresql://user:password@localhost:5432/test_db

# Netlify specific configuration
# NETLIFY_AUTH_TOKEN=your_token_here
# NETLIFY_SITE_ID=your_site_id_here
